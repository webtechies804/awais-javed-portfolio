---
import Site from '../layouts/Site.astro';
import Media from '../components/Media.astro';
import RichText from '../components/RichText.astro';
import { getSite, mediaFor } from '../lib/sanity';
const { settings, pages, media } = await getSite();
const page = pages.find(page => page.key === 'about');
if (!page) throw new Error('Missing Story page content');
const PhotoFrame = (page.photos?.length || 0) > 1 ? 'button' : 'div';
---
<Site title={`Story — ${settings.name}`} dark>
  <section class="hero grid-surface"><div class="hero-glow" aria-hidden="true"><Media media={mediaFor(media, page.glow)} eager alt="" /></div><div class="hero-content"><h1>{page.headline}</h1><a class="chrome-button hero-cta" href={`mailto:${settings.email}`} data-contact-link>{page.ctaLabel}<span aria-hidden="true">↗</span></a></div></section>
  <section class="about-story split-grid"><div class="about-copy"><h2>{page.storyHeading}</h2><RichText value={page.story} /></div><div class="photo-stack-area"><PhotoFrame class="photo-stack" data-photo-stack={(page.photos?.length || 0) > 1 ? true : undefined} type={PhotoFrame === 'button' ? 'button' : undefined} aria-label={PhotoFrame === 'button' ? 'Cycle through personal photos' : undefined}>{page.photos?.map((photo, n) => <div class="stack-photo" style={`--rotation:${[-5, 4, -2, 3, 0][n % 5]}deg;z-index:${n}`}><Media media={mediaFor(media, photo)} width={800} alt={mediaFor(media, photo)?.alt || `Personal photograph ${n + 1}`} /></div>)}</PhotoFrame></div></section>
  <section class="about-career split-grid"><div class="career-list">{page.career?.map(position => <article><Media media={mediaFor(media, position.icon)} alt="" width={150} /><div><h3>{position.role}</h3><p>{position.company}</p></div><time>{position.dates}</time></article>)}</div><div class="about-copy approach-copy"><h2>{page.approachHeading}</h2><RichText value={page.approach} />{page.resumeUrl && <a href={page.resumeUrl} target="_blank" rel="noopener noreferrer" class="chrome-button">↓ Download CV</a>}</div></section>
  <section class="about-closing"><h2 class="section-heading">{page.closingHeading}</h2><div class="closing-collage">{page.collage?.map((photo,n) => <div style={`--rotation:${[-9,5,17][n % 3]}deg`}><Media media={mediaFor(media, photo)} width={700} alt={`Personal collection ${n + 1}`} /></div>)}</div></section>
</Site>
