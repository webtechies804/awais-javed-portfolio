---
import Site from '../layouts/Site.astro';
import Media from '../components/Media.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getSite, mediaFor } from '../lib/sanity';
const { settings, pages, projects, services, media } = await getSite();
const page = pages.find(page => page.key === 'home');
if (!page) throw new Error('Missing homepage content');
---
<Site>
  <section class="hero grid-surface"><div class="hero-glow" aria-hidden="true"><Media media={mediaFor(media, page.glow)} alt="" eager /></div><div class="hero-content"><h1>{page.headline}</h1><a href={`mailto:${settings.email}`} class="chrome-button hero-cta" data-contact-link>{page.ctaLabel}<span aria-hidden="true">↗</span></a></div></section>
  <section class="work-section" id="work" aria-label="Selected projects"><p class="work-intro">{page.introduction}</p><div class="project-columns">{[1, 2].map(column => <div class="project-column">{projects.filter(project => project.column === column).map(project => <ProjectCard project={project} media={media} />)}{column === 2 && <a class="coming-soon" href="/reward-point"><span>More to explore<br />along the way</span><span aria-hidden="true">↗</span></a>}</div>)}</div></section>
  <section class="services-section"><h2 class="section-heading">{page.servicesHeading}</h2><div class="service-grid">{services.map(service => <article class="service-card"><div class="service-icons">{service.icons?.map(icon => <Media media={mediaFor(media, icon)} width={180} alt="" />)}</div><h3>{service.title}</h3><p>{service.description}</p></article>)}</div><div class="clients-heading">{page.clientsHeading}</div><div class="logo-grid">{page.logos?.map(logo => <div><Media media={mediaFor(media, logo)} width={260} alt="Client logo" /></div>)}</div></section>
  <section class="experiments-section"><div class="experiments-title"><h2 class="section-heading">{page.galleryHeading}</h2><div class="gallery-controls"><button class="chrome-button" data-gallery-direction="-1" aria-label="Previous experiments">←</button><button class="chrome-button" data-gallery-direction="1" aria-label="Next experiments">→</button></div></div><div class="experiment-track" tabindex="0" aria-label="Visual experiments gallery">{page.gallery?.map((item, n) => <figure style={`--tilt:${n % 2 ? 2 : -2}deg`}><Media media={mediaFor(media, item)} alt={`Visual experiment ${n + 1}`} width={1000} /></figure>)}</div></section>
</Site>
