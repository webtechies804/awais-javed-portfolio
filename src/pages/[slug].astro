---
import Site from '../layouts/Site.astro';
import Media from '../components/Media.astro';
import RichText from '../components/RichText.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getSite, mediaFor } from '../lib/sanity';
export async function getStaticPaths() { const { projects } = await getSite(); return projects.map(project => ({ params: { slug: project.slug!.current }, props: { project } })); }
const { project } = Astro.props;
const { media, projects } = await getSite();
const related = project.related?.map(ref => projects.find(p => p._id === ref._ref)).filter(p => !!p) || [];
---
<Site title={project.seoTitle || project.title} description={project.seoDescription || project.summary} project>
  <section class="project-hero grid-surface"><div class="project-heading"><Media media={mediaFor(media, project.icon)} width={120} alt="" eager /><h1>{project.title}</h1></div><p>{project.summary}</p></section>
  <div class="project-lead"><Media media={mediaFor(media, project.hero)} alt={`${project.title} overview`} eager width={2000} /></div>
  <section class="project-story"><div class="story-body"><h2>Behind the project</h2><RichText value={project.body} /></div><aside><div><h3>Services</h3><ul>{project.services?.map(service => <li>{service}</li>)}</ul></div><div><h3>Tools</h3><ul>{project.tools?.map(tool => <li>{tool}</li>)}</ul></div></aside></section>
  <section class="case-gallery" aria-label={`${project.title} gallery`}>{project.gallery?.map(block => block._type === 'galleryHeading' ? <h2 class="section-heading">{block.title}</h2> : <div class="case-row" style={`--columns:${block.items?.length || 1}`}>{block.items?.map((ref, n) => <figure><Media media={mediaFor(media, ref)} alt={`${project.title} design detail ${n + 1}`} width={2000} /></figure>)}</div>)}</section>
  {related.length > 0 && <section class="related-projects"><h2 class="section-heading">More selected work</h2><div class="related-grid">{related.map(project => <ProjectCard project={project} media={media} compact />)}</div></section>}
</Site>
