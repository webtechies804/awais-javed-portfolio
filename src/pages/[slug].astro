---
import '../styles/global.css';
import {getProject, knownSlugs, settingsQuery} from '../lib/content';
import {sanityClient} from 'sanity:client';

export async function getStaticPaths() {
	return Promise.all(knownSlugs.map(async (slug) => ({params: {slug}, props: {project: await getProject(slug)}})));
}
const {project} = Astro.props;
const settings = await sanityClient.fetch(settingsQuery);
if (!project) return Astro.redirect('/');
const email = settings?.email ?? 'hello@danielsun.space';
---
<html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><meta name="description" content={project.summary} /><title>{project.title} | Daniel Sun</title></head><body>
	<header class="nav"><a class="logo" href="/">Daniel Sun<span>.</span></a><nav><a href="/">Works</a><a href="/about">Story</a><a class="nav-chat" href={`mailto:${email}`}>Let's chat ↗</a></nav></header>
	<main class="case-study"><section class="case-hero wrap"><p class="eyebrow">{project.categories.join(' · ')}</p><h1>{project.title}</h1><p class="case-summary">{project.summary}</p><div class="case-hero-image">{project.heroImage?.url && <img src={project.heroImage.url} alt={`${project.title} hero`} />}</div></section>
		{project.sections.map((section) => <section class="case-section wrap"><p class="eyebrow">{section.heading}</p><p>{section.body}</p></section>)}
		{project.gallery?.length ? <section class="gallery wrap">{project.gallery.map((item) => item.image?.url && <figure><img src={item.image.url} alt={item.caption ?? project.title} loading="lazy" /><figcaption>{item.caption}</figcaption></figure>)}</section> : null}
		<section class="case-meta wrap"><div><p class="eyebrow">Services</p><p>{project.services?.join(' · ')}</p></div><div><p class="eyebrow">Tools</p><p>{project.tools?.join(' · ')}</p></div></section>
		<section class="closing wrap"><p class="eyebrow">{project.closingLabel ?? 'Visual direction & Web design'}</p><h2>Ready for the<br /><i>next adventure?</i></h2><a class="email" href={`mailto:${email}`}>{email} ↗</a></section>
	</main><footer class="footer wrap"><a href="/">← Back</a><a href={`mailto:${email}`}>Let's chat ↗</a></footer>
</body></html>